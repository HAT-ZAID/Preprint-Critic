  "definitions": {
    "rouge_l": "ROUGE-L F-measure with beta=1.2 from a token-level LCS. Tokens are lowercased matches of [a-z0-9]+; P=LCS/len(candidate), R=LCS/len(reference), F=(1+beta^2)*P*R/(R+beta^2*P). 0.0 when the reference (or candidate) is empty or the LCS is 0.",
    "template_keys": "Subset of ['summary_of_the_paper', 'strength_and_weaknesses', 'clarity,_quality,_novelty_and_reproducibility', 'summary_of_the_review'] found at the start of a line, case-insensitive, allowing leading '#', '*', '-', '>' or spaces and an optional ':' or '**'. These are the four sections Re\u00b2's own reviews use. template_count counts reviews with at least one key; has_all_four_count counts reviews with all four; summary_of_the_paper_count counts reviews with that one key.",
    "citation_grounding": "All matches of \\b(?:Section|Sec\\.?|Table|Tab\\.?|Figure|Fig\\.?)\\s*([0-9]+[A-Za-z]?), normalised to 'Section N', 'Table N' or 'Figure N'. A citation is grounded when its lowercased normalised form is a substring of the lowercased paper text. Grounding rate is grounded/total, 0.0 when there are no citations.",
    "ngram_repeat_rate": "n=5 over lowercased whitespace words: 1 - distinct_5grams/total_5grams, 0.0 when fewer than 5 words."
  },
